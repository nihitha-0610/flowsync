# ==============================================================================
# FlowSync — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit the actual .env file with real credentials to version control.
# ==============================================================================

# --- System & Application Settings ---
FLOWSYNC_ENV=development
FLOWSYNC_DEBUG=true
LOG_LEVEL=INFO

# --- Apache Kafka Configuration (KRaft Mode) ---
KAFKA_CONTAINER_NAME=flowsync-kafka
KAFKA_BROKER_INTERNAL=kafka:9092
KAFKA_BROKER_EXTERNAL=localhost:9094
KAFKA_TOPIC_RAW=events.raw
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_TOPIC_INVALID=events.invalid
KAFKA_TOPIC_ANOMALIES=events.anomalies

# --- PostgreSQL 16 Database Configuration ---
POSTGRES_CONTAINER_NAME=flowsync-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flowsync_db
POSTGRES_USER=flowsync_user
POSTGRES_PASSWORD=flowsync_secure_password
DATABASE_URL=postgresql+asyncpg://flowsync_user:flowsync_secure_password@postgres:5432/flowsync_db
DATABASE_SYNC_URL=postgresql://flowsync_user:flowsync_secure_password@postgres:5432/flowsync_db

# --- MinIO Object Storage Configuration ---
MINIO_CONTAINER_NAME=flowsync-minio
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=flowsync_admin
MINIO_ROOT_PASSWORD=flowsync_minio_secret_key
MINIO_BUCKET_RAW=flowsync-raw
MINIO_BUCKET_REFINED=flowsync-refined
MINIO_BUCKET_QUARANTINE=flowsync-quarantine
MINIO_BUCKET_CHECKPOINTS=flowsync-checkpoints
MINIO_BUCKET_MODELS=flowsync-models

# --- Apache Spark & PySpark Configuration ---
SPARK_MASTER=local[*]
SPARK_APP_NAME=FlowSyncStreamProcessor
SPARK_CHECKPOINT_DIR=s3a://flowsync-checkpoints/spark/telemetry_pipeline

# --- Prometheus Monitoring Configuration ---
PROMETHEUS_CONTAINER_NAME=flowsync-prometheus
PROMETHEUS_PORT=9090

# --- Grafana Dashboard Configuration ---
GRAFANA_CONTAINER_NAME=flowsync-grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=flowsync_grafana_admin

# --- FastAPI Backend Service ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- React + TypeScript Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
